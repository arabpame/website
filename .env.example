# =========================================
# EARTHLINK Philippines environment variables
#
# Copy to .env.local for development.
# Set the same keys in the Vercel dashboard for production.
# Never commit .env.local.
#
# IMPORTANT: this project folder is inside OneDrive, so a gitignored .env.local
# still syncs to the cloud. The source of truth for every production value is the
# provider dashboard, never a file on a laptop.
# =========================================

# --- Site ---
# The canonical URL. Used for metadata, canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=

# =========================================
# REPORT INTAKE (live since 16 September 2026)
#
# The Report page files real reports: they are saved to Supabase, given a case
# number, shown on the map, and emailed to the founder. Without these values:
#   - on a laptop, reports go to a local file under .cache/ so the flow can be
#     developed offline;
#   - on Vercel, the Report page says reporting is temporarily unavailable.
# Setup: supabase/README.md
# =========================================

# --- Database and evidence storage (Supabase) ---
# Project URL, from Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
# Server only. Bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Not read yet. Listed for the Phase 2 admin console.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Report notification email (Resend) ---
# Every filed report is emailed here with its photographs attached.
RESEND_API_KEY=
REPORTS_TO_EMAIL=
# Optional. Until a domain is verified in Resend this must stay unset, and
# Resend will only deliver to the address that owns the Resend account.
FROM_EMAIL=

# =========================================
# Everything below is PHASE 2 and later.
# The site runs without it. The keys are listed now so a new machine knows what
# is coming.
# =========================================

# --- Evidence storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Contact form email (Resend, same key as above) ---
CONTACT_TO_EMAIL=

# --- Bot protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash. Falls back to in-memory in development) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin console ---
# Required in Phase 2. The app must refuse to start without them rather than
# falling back to a known value.
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
