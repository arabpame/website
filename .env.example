# =========================================
# EARTHLINK Philippines environment variables
#
# Copy to .env.local for development.
# Set the same keys in the Vercel dashboard for production.
# Never commit .env.local.
#
# IMPORTANT: this project folder is inside OneDrive, so a gitignored .env.local
# still syncs to the cloud. The source of truth for every production value is the
# provider dashboard, never a file on a laptop.
# =========================================

# --- Site ---
# The canonical URL. Used for metadata, canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=

# =========================================
# Everything below is PHASE 2 and later.
# The Phase 1 design build reads none of it, and the site runs with an empty
# .env.local. The keys are listed now so a new machine knows what is coming.
# =========================================

# --- Database and auth (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Evidence storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Transactional email (Resend) ---
# Scope the key to one sending domain, send only.
RESEND_API_KEY=
FROM_EMAIL=
CONTACT_TO_EMAIL=
REPORTS_TO_EMAIL=

# --- Bot protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash. Falls back to in-memory in development) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin console ---
# Required in Phase 2. The app must refuse to start without them rather than
# falling back to a known value.
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
