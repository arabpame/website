# Dependencies
node_modules/
.pnp
.pnp.js

# Build output. Machine-specific, never trust across laptops, always safe to delete.
# npm run clean removes all of these.
.next/
out/
build/
dist/
.turbo/
.vite/

# Map build cache. Regenerated by npm run map:build. The OUTPUT (data/ph-map.json)
# is committed on purpose so the build never needs the network.
.cache/

# Environment. Never commit. Note that .gitignore protects the repo, not the disk:
# this folder lives in OneDrive, so a gitignored secret still syncs to the cloud.
.env
.env*.local

# Claude. The shared config is committed, only the machine-local parts are ignored.
.claude/settings.local.json
.claude/worktrees/

# Editor and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Testing and misc
coverage/
*.tsbuildinfo
next-env.d.ts
.vercel

# Studio commercial notes. Never commit: the GitHub repo for this project is public.
PRIVATE-NOTES.md

# Photograph masters. The full-size originals, kept out of git: public/photos
# holds the web-sized derivatives that npm run photos:optimize produces.
photos-master/
