{
  "name": "earthlink-philippines",
  "version": "0.1.0",
  "private": true,
  "description": "EARTHLINK Philippines. A digital environmental action platform. Phase 1 design build.",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "next dev -p 3033",
    "build": "next build",
    "start": "next start -p 3033",
    "lint": "eslint app components lib",
    "typecheck": "tsc --noEmit",
    "qa": "node scripts/qa-check.mjs",
    "grammar": "node scripts/grammar-check.mjs",
    "security": "node scripts/security-check.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "clean": "node scripts/clean.mjs",
    "map:build": "node scripts/build-map.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "photos:optimize": "node scripts/optimize-photos.mjs",
    "vercel:login": "npx --yes vercel login",
    "verify": "npm run typecheck && npm run contrast && npm run qa && npm run grammar && npm run security && npm run build"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3"
  }
}
